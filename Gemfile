source "https://rubygems.org"

# The Minimal Mistakes theme files (_includes, _layouts, _sass, assets) are
# vendored in this repository, so only the Jekyll engine and its plugins are
# pulled in as gems. jekyll-include-cache is required by the theme layouts.
gem "jekyll", "~> 4.3"
gem "jekyll-include-cache", "~> 0.2"
gem "jekyll-sitemap", "~> 1.4"
